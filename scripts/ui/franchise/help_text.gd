## Every stashed string whose key starts with `prefix` ("team." gives the whole Team tab).
static func for_screen(prefix: String) -> Array:
	var out: Array = []
	for k in TEXT:
		if String(k).begins_with(prefix):
			out.append(TEXT[k])
	return out
